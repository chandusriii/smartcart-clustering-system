  {
   "cell_type": "markdown",
   "id": "10da909f-fbd8-41d7-8848-fd7e05f2c023",
   "metadata": {},
   "source": [
    "## Feature engineering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "c0552af1-b840-4ac0-bf06-8e630dc60db3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Age\n",
    "df[\"Age\"] = 2026-df[\"Year_Birth\"]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "6315ffa7-10cd-4d3f-b4c6-607d8f3f3e60",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Customer Joining Date\n",
    "df[\"Dt_Customer\"] = pd.to_datetime(df[\"Dt_Customer\"], dayfirst=True)\n",
    "\n",
    "reference_date = df[\"Dt_Customer\"].max()\n",
    "\n",
    "df[\"Customer_Tenure_Days\"] = (reference_date - df[\"Dt_Customer\"]).dt.days"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "982d7963-6d64-4d64-88b9-9d69bc707b00",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Spending\n",
    "\n",
    "df[\"Total_Spending\"] = df[\"MntWines\"] + df[\"MntFruits\"] + df[\"MntMeatProducts\"]  + df[\"MntFishProducts\"] + df[\"MntSweetProducts\"] + df[\"MntGoldProds\"]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "b71bbc63-3bb6-49a4-b5de-564618e6d8bc",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Children\n",
    "df[\"Total_Children\"] = df[\"Kidhome\"] + df[\"Teenhome\"]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "5a5f146f-d259-4d38-8313-3a651d972edc",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Education\n",
    "\n",
    "df[\"Education\"].value_counts()\n",
    "\n",
    "df[\"Education\"] = df[\"Education\"].replace({\n",
    "    \"Basic\": \"Undergraduate\", \"2n Cycle\": \"Undergraduate\",\n",
